---
import { Image } from 'astro:assets';
interface Props { slug: string; titulo: string; compositor: string; año: number; gancho: string; acento: string; cartel: ImageMetadata; indice: number; }
const { slug, titulo, compositor, año, gancho, acento, cartel, indice } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a class="cartel" href={`${base}obra/${slug}/`} style={`--acento:${acento}; --retardo:${indice * 120}ms`}>
  <Image src={cartel} alt={`${titulo} — ${compositor}`} widths={[420, 840]} sizes="(max-width: 700px) 80vw, 320px" />
  <div class="velo"></div>
  <div class="ficha">
    <span class="ui">{compositor} · {año}</span>
    <h2>{titulo}</h2>
    <p class="gancho">{gancho}</p>
  </div>
</a>
<style>
  .cartel { position: relative; display: block; aspect-ratio: 2/3; overflow: hidden; text-decoration: none;
    opacity: 0; animation: aparecer 1.4s ease var(--retardo) forwards; }
  .cartel img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.35) contrast(1.08) brightness(0.72);
    transition: transform 6s ease, filter 1.2s ease; }
  .velo { position: absolute; inset: 0; background: linear-gradient(15deg, #0a0a0af2 22%, #0a0a0a55 60%, #0a0a0a11); }
  .ficha { position: absolute; inset: auto 0 0 0; padding: 1.4rem; }
  .ficha .ui { color: var(--acento); }
  .ficha h2 { font-size: 1.6rem; margin: 0.35rem 0; }
  .gancho { font-size: 0.95rem; opacity: 0; transform: translateY(12px); transition: all 1.2s ease; font-style: italic; }
  .cartel:hover img, .cartel:focus-visible img { transform: scale(1.05); filter: grayscale(0.1) contrast(1.08) brightness(0.85); }
  .cartel:hover .gancho, .cartel:focus-visible .gancho { opacity: 1; transform: none; }
  @keyframes aparecer { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .cartel { animation: none; opacity: 1; } }
</style>
