---
import '../styles/global.css';
interface Props { titulo: string; descripcion: string; acento?: string; ogImage?: string; }
const { titulo, descripcion, acento, ogImage } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} — El Motivo</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={`${titulo} — El Motivo`} />
    <meta property="og:description" content={descripcion} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body style={acento ? `--acento:${acento}` : undefined}>
    <slot />
  </body>
</html>
